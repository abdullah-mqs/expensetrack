import {
    DashboardIcon,
    DocumentIcon,
    SettingsIcon,
    HelpIcon,
} from "../icons/paths.slint";
import { AppPage } from "../types/types.slint";

export component Sidebar inherits Rectangle {
    in-out property <AppPage> current-page: AppPage.dashboard;
    in-out property <length> w;
    in-out property <float> zoom: 1.0;
    width: root.w;
    background: #0A0E14;

    VerticalLayout {
        VerticalLayout {
            alignment: start;
            VerticalLayout {
                padding-top: 18px * root.zoom;
                alignment: start;
                Rectangle {
                    HorizontalLayout {
                        padding-left: 18px * root.zoom;
                        Text {
                            text: "ExpenseTrack";
                            font-size: 18px * root.zoom;
                            font-weight: 600;
                            color: #DFE2EB;
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 1.8px * root.zoom;
                padding: 18px * root.zoom;
                VerticalLayout {
                    padding-bottom: 4.5px * root.zoom;
                    padding-left: 7.2px * root.zoom;
                    Text {
                        text: "MENU";
                        color: #86948A;
                        font-size: 9.9px * root.zoom;
                    }
                }

                Rectangle {
                    height: 36px * root.zoom;
                    background: root.current-page == AppPage.dashboard ? #10B981 : transparent;
                    border-radius: 45px * root.zoom;
                    drop-shadow-blur: 9px * root.zoom;
                    drop-shadow-color: root.current-page == AppPage.dashboard ? #10B981 : transparent;
                    drop-shadow-offset-x: 0px;
                    drop-shadow-offset-y: 1.8px * root.zoom;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 18px * root.zoom;
                        HorizontalLayout {
                            VerticalLayout {
                                alignment: center;
                                padding-right: 9px * root.zoom;
                                DashboardIcon {
                                    width: 18px * root.zoom;
                                    height: 18px * root.zoom;
                                    c: root.current-page == AppPage.dashboard ? #00422B : #BBCABF;
                                }
                            }

                            HorizontalLayout {
                                VerticalLayout {
                                    Text {
                                        text: "Dashboard";
                                        font-size: 14.4px * root.zoom;
                                        color: root.current-page == AppPage.dashboard ? #00422B : #BBCABF;
                                        font-weight: 550;
                                    }
                                }
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.current-page = AppPage.dashboard;
                        }
                    }
                }

                Rectangle {
                    height: 36px * root.zoom;
                    background: root.current-page == AppPage.expenses ? #10B981 : transparent;
                    border-radius: 45px * root.zoom;
                    drop-shadow-blur: 9px * root.zoom;
                    drop-shadow-color: root.current-page == AppPage.expenses ? #10B981 : transparent;
                    drop-shadow-offset-x: 0px;
                    drop-shadow-offset-y: 1.8px * root.zoom;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 18px * root.zoom;
                        HorizontalLayout {
                            VerticalLayout {
                                alignment: center;
                                padding-right: 9px * root.zoom;
                                DocumentIcon {
                                    width: 19.8px * root.zoom;
                                    height: 19.8px * root.zoom;
                                    c: root.current-page == AppPage.expenses ? #00422B : #BBCABF;
                                }
                            }

                            HorizontalLayout {
                                VerticalLayout {
                                    Text {
                                        text: "Expenses";
                                        font-size: 14.4px * root.zoom;
                                        color: root.current-page == AppPage.expenses ? #00422B : #BBCABF;
                                        font-weight: 550;
                                    }
                                }
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.current-page = AppPage.expenses;
                        }
                    }
                }

                Rectangle {
                    height: 36px * root.zoom;
                    background: root.current-page == AppPage.settings ? #10B981 : transparent;
                    border-radius: 45px * root.zoom;
                    drop-shadow-blur: 9px * root.zoom;
                    drop-shadow-color: root.current-page == AppPage.settings ? #10B981 : transparent;
                    drop-shadow-offset-x: 0px;
                    drop-shadow-offset-y: 1.8px * root.zoom;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 18px * root.zoom;
                        HorizontalLayout {
                            VerticalLayout {
                                alignment: center;
                                padding-right: 9px * root.zoom;
                                SettingsIcon {
                                    width: 19.8px * root.zoom;
                                    height: 19.8px * root.zoom;
                                    c: root.current-page == AppPage.settings ? #00422B : #BBCABF;
                                }
                            }

                            HorizontalLayout {
                                VerticalLayout {
                                    Text {
                                        text: "Settings";
                                        font-size: 14.4px * root.zoom;
                                        color: root.current-page == AppPage.settings ? #00422B : #BBCABF;
                                        font-weight: 550;
                                    }
                                }
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.current-page = AppPage.settings;
                        }
                    }
                }

                Rectangle {
                    height: 36px * root.zoom;
                    background: root.current-page == AppPage.help ? #10B981 : transparent;
                    border-radius: 45px * root.zoom;
                    drop-shadow-blur: 9px * root.zoom;
                    drop-shadow-color: root.current-page == AppPage.help ? #10B981 : transparent;
                    drop-shadow-offset-x: 0px;
                    drop-shadow-offset-y: 1.8px * root.zoom;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 18px * root.zoom;
                        HorizontalLayout {
                            VerticalLayout {
                                alignment: center;
                                padding-right: 9px * root.zoom;
                                HelpIcon {
                                    width: 19.8px * root.zoom;
                                    height: 19.8px * root.zoom;
                                    c: root.current-page == AppPage.help ? #00422B : #BBCABF;
                                }
                            }

                            HorizontalLayout {
                                VerticalLayout {
                                    Text {
                                        text: "Help";
                                        font-size: 14.4px * root.zoom;
                                        color: root.current-page == AppPage.help ? #00422B : #BBCABF;
                                        font-weight: 550;
                                    }
                                }
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.current-page = AppPage.help;
                        }
                    }
                }
            }
        }
    }
}
