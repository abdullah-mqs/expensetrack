// Notification Icon
export component NotificationIcon inherits Rectangle {
    width: 24px;
    height: 24px;

    in-out property <brush> icon-color: #cbd5e1;
    in-out property <brush> dot-color: #10b981;
    in-out property <bool> show-dot: true;

    Path {
        width: 100%;
        height: 100%;
        stroke: root.icon-color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;

        viewbox-width: 24;
        viewbox-height: 24;

        commands: "M 18,8 A 6,6 0 0,0 6,8 c 0,7 -3,9 -3,9 h 18 s -3,-2 -3,-9 Z M 13.73,21 a 2,2 0 0,1 -3.46,0";
    }

    if (root.show-dot): Rectangle {
        x: 14px;
        y: 2px;
        width: 7px;
        height: 7px;
        background: root.dot-color;
        border-radius: 3.5px;
    }
}

