
// 1. Dashboard - 2x2 Grid
export component DashboardIcon inherits Path {
    in-out property <brush> c;
    width: 20px;
    height: 20px;
    fill: transparent;
    stroke: root.c;
    stroke-width: 1.5px;
    commands: "M 3 3 L 10 3 L 10 10 L 3 10 Z M 14 3 L 21 3 L 21 10 L 14 10 Z M 3 14 L 10 14 L 10 21 L 3 21 Z M 14 14 L 21 14 L 21 21 L 14 21 Z";
}
// 2. Document / List - Page + 3 Lines
export component DocumentIcon inherits Path {
    in-out property <brush> c;
    width: 20px;
    height: 20px;
    fill: transparent;
    stroke: root.c;
    stroke-width: 1.5px;
    commands: "M 6 2 L 14 2 L 18 6 L 18 20 L 18 22 L 6 22 Z M 14 2 L 14 6 L 18 6 M 8 10 L 16 10 M 8 14 L 16 14 M 8 18 L 16 18";
}
// 3. Settings - Gear
export component SettingsIcon inherits Path {
    in-out property <brush> c;

    width: 20px;
    height: 20px;
    fill: transparent;
    stroke: root.c;
    stroke-width: 1.5px;
    commands: "M 12 8 A 4 4 0 1 1 12 16 A 4 4 0 1 1 12 8 Z M 12 2 L 13.5 4.5 L 16 3.5 L 17 6 L 19.5 6.5 L 19 9 L 21.5 10.5 L 20 12.5 L 21.5 14.5 L 19 16 L 19.5 18.5 L 17 19 L 16 21.5 L 13.5 20.5 L 12 22 L 10.5 20.5 L 8 21.5 L 7 19 L 4.5 18.5 L 5 16 L 2.5 14.5 L 4 12.5 L 2.5 10.5 L 5 9 L 4.5 6.5 L 7 6 L 8 3.5 L 10.5 4.5 Z";
}
// 4. Help - ? in Circle
export component HelpIcon inherits Rectangle {
    in-out property <brush> c;
    width: 20px;
    height: 20px;

    Path {
        width: 100%;
        height: 100%;
        stroke: root.c;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 10,1.5 A 8.5,8.5 0 1,1 10,18.5 A 8.5,8.5 0 1,1 10,1.5 Z M 7.5,7 A 2.5,2.5 0 0,1 12.5,7 C 12.5,9.2 10,9.5 10,12 M 10,15.5 L 10.01,15.5";
    }
}

// Search - Magnifying Glass
export component SearchIcon inherits Path {
    in property <color> c: white;
    width: 18px;
    height: 18px;
    fill: transparent;
    stroke: root.c;
    stroke-width: 1.5px;
    commands: "M 10.5,6.25 A 4.25,4.25 0 1,1 10.5,14.75 A 4.25,4.25 0 1,1 10.5,6.25 Z M 13.5,13.5 L 18,18";
}

// Notification Icon
export component NotificationIcon inherits Rectangle {
    width: 24px;
    height: 24px;

    in-out property <brush> icon-color: #cbd5e1;
    in-out property <brush> dot-color: #10b981;
    in-out property <bool> show-dot: true;

    Path {
        width: 100%;
        height: 100%;
        stroke: root.icon-color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;

        viewbox-width: 24;
        viewbox-height: 24;

        commands: "M 18,8 A 6,6 0 0,0 6,8 c 0,7 -3,9 -3,9 h 18 s -3,-2 -3,-9 Z M 13.73,21 a 2,2 0 0,1 -3.46,0";
    }

    if (root.show-dot): Rectangle {
        x: 14px;
        y: 2px;
        width: 7px;
        height: 7px;
        background: root.dot-color;
        border-radius: 3.5px;
    }
}

