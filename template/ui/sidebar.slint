export enum NavTab { Dashboard, Profile, Setting }

export component Sidebar inherits Rectangle {
    in-out property <NavTab> current-selection: NavTab.Dashboard;
    in-out property <length> sidebar-width: 300px;
    width: sidebar-width;
    x: 0px;
    background: #161615;

    VerticalLayout {
        padding: 25px;
        spacing: 20px;
        alignment: start;

        Text {
            text: "STUDYFLOW";
            color: #2ceb89;
            font-size: 18px;
            font-weight: 700;
        }

        Rectangle {
            height: 10px;
        }

        // --- Dashboard Tab ---
        Rectangle {
            height: 55px;
            border-radius: 8px;
            background: root.current-selection == NavTab.Dashboard ? #1e1e1e : (ta-dash.has-hover ? #181818 : transparent);
            border-width: 2px;
            border-color: root.current-selection == NavTab.Dashboard ? #2ceb89 : (ta-dash.has-hover ? #444444 : transparent);

            HorizontalLayout {
                padding-left: 20px;
                spacing: 15px;
                alignment: start;
                cross-axis-alignment: center;

                Path {
                    width: 20px;
                    height: 20px;
                    stroke: root.current-selection == NavTab.Dashboard ? #2ceb89 : (ta-dash.has-hover ? #cccccc : #888888);
                    stroke-width: 2px;
                    commands: "M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z";
                }

                Text {
                    text: "Dashboard";
                    color: root.current-selection == NavTab.Dashboard ? #ffffff : (ta-dash.has-hover ? #ffffff : #888888);
                    font-size: 14px;
                }
            }

            ta-dash := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.current-selection = NavTab.Dashboard;
                }
            }
        }

        // --- Profile Tab ---
        Rectangle {
            height: 55px;
            border-radius: 8px;
            background: root.current-selection == NavTab.Profile ? #1e1e1e : (ta-prof.has-hover ? #181818 : transparent);
            border-width: 2px;
            border-color: root.current-selection == NavTab.Profile ? #2ceb89 : (ta-prof.has-hover ? #444444 : transparent);

            HorizontalLayout {
                padding-left: 20px;
                spacing: 15px;
                alignment: start;
                cross-axis-alignment: center;

                Path {
                    width: 20px;
                    height: 20px;
                    stroke: root.current-selection == NavTab.Profile ? #2ceb89 : (ta-prof.has-hover ? #cccccc : #888888);
                    stroke-width: 2px;
                    commands: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z";
                }

                Text {
                    text: "Profile";
                    color: root.current-selection == NavTab.Profile ? #ffffff : (ta-prof.has-hover ? #ffffff : #888888);
                    font-size: 14px;
                }
            }

            ta-prof := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.current-selection = NavTab.Profile;
                }
            }
        }

        // --- Setting Tab ---
        Rectangle {
            height: 55px;
            border-radius: 8px;
            background: root.current-selection == NavTab.Setting ? #1e1e1e : (ta-set.has-hover ? #181818 : transparent);
            border-width: 2px;
            border-color: root.current-selection == NavTab.Setting ? #2ceb89 : (ta-set.has-hover ? #444444 : transparent);

            HorizontalLayout {
                padding-left: 20px;
                spacing: 15px;
                alignment: start;
                cross-axis-alignment: center;

                Path {
                    width: 20px;
                    height: 20px;
                    stroke: root.current-selection == NavTab.Setting ? #2ceb89 : (ta-set.has-hover ? #cccccc : #888888);
                    stroke-width: 2px;
                    commands: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z";
                }

                Text {
                    text: "Setting";
                    color: root.current-selection == NavTab.Setting ? #ffffff : (ta-set.has-hover ? #ffffff : #888888);
                    font-size: 14px;
                }
            }

            ta-set := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.current-selection = NavTab.Setting;
                }
            }
        }
    }

    Rectangle {
        width: 6px;
        x: parent.width - self.width;
        height: 100%;

        ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                    // Mouse ki movement ke hisaab se width change hogi
                    // Math.max aur Math.min se limit laga di ke 200px se kam aur 450px se ziada na ho
                    root.sidebar-width = Math.max(200px, Math.min(450px, root.sidebar-width + self.mouse-x - self.pressed-x));
            }
        }
    }
}
